# lkql version: 2

|"" LKQL stdlib module
|""
|"" This module contains functions that are shared accross lkql_checker rules.
|"" These functions may be moved in the future in Libadalang or LKQL's builtin
|"" library.

from libadalang import *
import libadalang_rewriting as rewriting

import stdlib_internal

|" Yields the chain of super types of the given type, as viewed from that
|" type. Hence, for a type T which public view derives from a type A but
|" private view derives from a type B (which itself derives from A),
|" invoking this selector on the public view of T will yield A.
fun super_types(this : BaseTypeDecl, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Stream[BaseTypeDecl] =
    unfold(super_types_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun super_types_body(this : BaseTypeDecl) : Rec[BaseTypeDecl, BaseTypeDecl] = match this {
    case BaseTypeDecl => Rec(this.p_base_types(), this.p_base_types())
    case _ => Rec[BaseTypeDecl, BaseTypeDecl]([], [])
}


|" Yields the chain of super types of the given type in their most complete
|" view. Hence, for a type T which public view derives from a type A but
|" private view derives from a type B (which itself derives from A),
|" invoking this selector on the public view of T will yield B and then A.
fun complete_super_types(this : BaseTypeDecl, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Stream[BaseTypeDecl] =
    unfold(complete_super_types_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun complete_super_types_body(this : BaseTypeDecl) : Rec[BaseTypeDecl, BaseTypeDecl] = match this {
    case b @ BaseTypeDecl when b.p_is_private() => {
        # We go through `p_base_subtype` to correctly handle SubtypeDecl nodes:
        # while they themselves don't have a next part, their base type may.
        val np = this.p_base_subtype().p_next_part();
        val typ = if np == null then this else np;
        Rec(typ.p_base_types(), typ.p_base_types())
    }
    case BaseTypeDecl =>
        Rec(this.p_base_types(), this.p_base_types())
    case _ => Rec[BaseTypeDecl, BaseTypeDecl]([], [])
}


|" Return all semantic parent nodes starting from a given node.
fun semantic_parent(this : AdaNode, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Stream[AdaNode] =
    unfold(semantic_parent_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun semantic_parent_body(this : AdaNode) : Rec[AdaNode, AdaNode] = match this {
    case null     => Rec[AdaNode, AdaNode]([], [])
    case _        => Rec(non_null(this.p_semantic_parent()), non_null(this.p_semantic_parent()))
}


|" Return all children nodes starting from a base subprogram body, but not
|" entering in nested bodies.
fun children_no_nested(node : AdaNode) : Stream[AdaNode] =
    stdlib_internal.children_no_nested_implem(Pair(node, true))

|" Return whether all elements in the given iterable are truthy
fun all(iterable : Stream[Bool]) : Bool = iterable.all((x) => x)

|" Return whether at least one element in the given iterable is truthy
fun any(iterable : Stream[Bool]) : Bool = iterable.any((x) => x)

|" Return ``true`` if the string ``s`` is the name of an assert pragma
fun is_assert_pragma(s : String) : Bool =
    s == "assert" or
    s == "assert_and_cut" or
    s == "assume" or
    s == "contract_cases" or
    s == "debug" or
    s == "invariant" or
    s == "loop_invariant" or
    s == "loop_variant" or
    s == "postcondition" or
    s == "precondition" or
    s == "predicate" or
    s == "refined_post"

|" Return ``true`` if the string ``s`` is the name of an assert aspect
fun is_assert_aspect(s : String) : Bool =
    s == "static_predicate" or
    s == "dynamic_predicate" or
    s == "pre" or
    s == "post" or
    s == "type_invariant" or
    s == "contract_cases" or
    s == "invariant" or
    s == "predicate" or
    s == "refined_post" or
    s == "default_initial_condition" or
    s == "predicate_failure"

|" Return ``true`` if ``node`` is part of an assertion-related pragma or
|" aspect.
fun within_assert(node : AdaNode) : Bool =
    parent(node).any((n) => n is (
        p @ PragmaNode when is_assert_pragma(p.f_id?.p_canonical_text())
    ) | a @ AspectAssoc when match a.f_id {
            case id @ Identifier   =>
                is_assert_aspect(id.p_canonical_text())
            case at @ AttributeRef =>
                at.f_attribute?.p_canonical_text() == "class"
            case _               => false
        }
    )

|" List of the nonoverridable aspects (RM 13.1.1) that denote a subprogram,
|" omitting those denoting a subtype or a discriminant.
val subprogram_denoting_nonoverridable_aspects = [
    "Aggregate", "Constant_Indexing", "Variable_Indexing", "Default_Iterator",
    "Integer_Literal", "Real_Literal", "String_Literal"
]

|" Return the ultimately designated ``ObjectDecl``, going through renamings
|" This will not go through generic instantiations. If all_nodes is true,
|" consider all kinds of nodes, otherwise consider only ``BaseId`` and
|" ``DottedName``. If ``strip_component`` is true, go to the prefix when
|" encountering a component, otherwise stop at the ``ComponentDecl``.
@memoized
fun ultimate_alias(name : Name, all_nodes : Bool=true, strip_component : Bool=false) : AdaNode =
    if all_nodes or name is (BaseId | DottedName) then {
        val decl = name.p_referenced_decl();

        match decl {
            case ObjectDecl(f_renaming_clause: r @ RenamingClause) =>
                ultimate_alias(r.f_renamed_object, all_nodes, strip_component)
            case ComponentDecl when strip_component and name is DottedName =>
                ultimate_alias(name.as[DottedName].f_prefix, all_nodes, strip_component)
            case _ => decl
        }
    } else name

|" Return the ultimately designated ``ExceptionDecl``, going through renamings
@memoized
fun ultimate_exception_alias(name : Name) : BasicDecl =
    match name.p_referenced_decl() {
        case ExceptionDecl(f_renames: rc@RenamingClause) =>
            ultimate_exception_alias(rc?.f_renamed_object)
        case decl => decl
    }

|" Return the ultimately designated ``BasicSubpDecl``, going through renamings
@memoized
fun ultimate_subprogram_alias(decl: BasicDecl) : BasicDecl = match decl {
    case srd@SubpRenamingDecl => ultimate_subprogram_alias(
        srd.f_renames.f_renamed_object.p_referenced_decl()
    )
    case _ => decl
}

|" Return the ultimately designated ``GenericDecl``, going through renamings
@memoized
fun ultimate_generic_alias(name : Name) : AdaNode =
    match name.p_referenced_decl() {
        case r@GenericPackageRenamingDecl =>
            ultimate_generic_alias(r.f_renames.f_renamed_object)
        case r@GenericSubpRenamingDecl =>
            ultimate_generic_alias(r.f_renames.f_renamed_object)
        case _ => name
    }


|" Return ``true`` if ``n`` is enclosed in a local scope
@memoized
fun has_local_scope(n : AdaNode) : Bool =
    n.parent is GenericFormalObjDecl or
    n is node when semantic_parent(node).any(
        (n) => n is BasicSubpDecl | SubpBody | TaskBody |
                    ExprFunction | BlockStmt | EntryBody |
                    ProtectedBody
    )

|" Return ``true`` if ``o`` represents a local ``ObjectDecl`` or ``ParamSpec``
fun is_local_object(o : BasicDecl) : Bool =
    o is (ParamSpec | ObjectDecl when has_local_scope(o))

|" Return ``true`` if ``o`` is immediately in the scope of a package spec,
|" body or generic package.
@memoized
fun is_in_package_scope(o : Node) : Bool = match o?.parent {
    case BasePackageDecl     => true
    case PackageBody         => true
    case SingleTaskDecl      => false
    case TaskTypeDecl        => false
    case TaskBody            => false
    case BlockStmt           => false
    case BaseSubpBody        => false
    case EntryBody           => false
    case SingleProtectedDecl => false
    case ProtectedTypeDecl   => false
    case null                => false
    case _                   => is_in_package_scope(o?.parent)
}


|" Return ``true`` if ``n`` is a program unit spec, body or stub
fun is_program_unit(n : AdaNode) : Bool =
    n is (SubpDecl | AbstractSubpDecl | BaseSubpBody
      | BasePackageDecl | PackageBody | GenericPackageInstantiation
      | GenericDecl | GenericInstantiation
      | SingleTaskDecl | TaskTypeDecl | TaskBody
      | SubpBodyStub | ProtectedBodyStub | PackageBodyStub | TaskBodyStub
      | SingleProtectedDecl | ProtectedTypeDecl)

|" Return ``true`` if ``o`` is located in a library unit body
@memoized
fun is_in_library_unit_body(o : Node) : Bool = match o?.parent {
    case s @ SubpBody    => s?.parent is LibraryItem
    case p @ PackageBody => p?.parent is LibraryItem
    case null          => false
    case _             => is_in_library_unit_body(o?.parent)
}


|" Return the position of node ``n`` in its current list of siblings
fun param_pos(n : Node, pos: Int = 0) : Int =
    if n == null then pos else param_pos(n?.previous_sibling(), pos+1)

# TODO: move this in LAL
|" Return true if ``op`` is a predefined operator; ``op`` can be an Op or
|" a CallExpr.
fun is_predefined_op(op : Name, follow_renamings : Bool=false) : Bool = {
    val ref = if follow_renamings
              then ultimate_subprogram_alias(op.p_referenced_decl())
              else op.p_referenced_decl();
    op is (Op | CallExpr(p_is_call(): true)) and
    if ref != null then ref.p_is_predefined_operator() else true
}

|" Return ``true`` if ``n`` is the name of a numeric type or subtype in Standard
fun is_standard_numeric(n : String) : Bool =
    n == "standard.integer" or
    n == "standard.natural" or
    n == "standard.positive" or
    n == "standard.short_short_integer" or
    n == "standard.short_integer" or
    n == "standard.long_integer" or
    n == "standard.long_long_integer" or
    n == "standard.long_long_long_integer" or
    n == "standard.short_float" or
    n == "standard.float" or
    n == "standard.long_float" or
    n == "standard.long_long_float" or
    n == "standard.duration"

|" Return true if the root type of ``n`` is ``Standard.Boolean``.
fun is_standard_boolean(n : Expr) : Bool =
    n.p_expression_type() is t @ BaseTypeDecl when t.p_root_type() == n.p_bool_type()

|" Get whether the given node is a Name representing the True literal
|" of the standard Boolean type, or of any type deriving from it.
fun is_standard_true(node : AdaNode) : Bool =
    node is name@Name(p_referenced_decl(): EnumLiteralDecl(p_relative_name_text(): "true")) when is_standard_boolean(name)

|" Get whether the given node is a Name representing the False literal
|" of the standard Boolean type, or of any type deriving from it.
fun is_standard_false(node : AdaNode) : Bool =
    node is name@Name(p_referenced_decl(): EnumLiteralDecl(p_relative_name_text(): "false")) when is_standard_boolean(name)

|" Return whether ``node`` is a "not" unary operation, returning a standard
|" boolean, and having as operand a predefined RelationOp or UnOp with
|" OpNeq as operator.
fun is_negated_op(node : Expr) : Bool =
    node is unop@UnOp(f_op: nop @ OpNot)
    when is_predefined_op(nop)
     and is_standard_boolean(node)
     and strip_conversions(unop.f_expr) is (
        ro@RelationOp when is_predefined_op(ro.f_op)
        | UnOp(f_op: op@OpNot) when is_predefined_op(op))

|" Assumes that ``node`` is either a RelationOp or UnOp with the OpNot
|" as operator. Returns the negated form of the operation as a rewriting
|" node.
|" Examples:
|" ``negate_op("A = B") -> "A /= B"``
|" ``negate_op("A > B") -> "A <= B"``
|" ``negate_op("not A") -> "A"``
fun negate_op(node : Expr) : rewriting.Expr = match node {
    case notop @ UnOp(f_op: OpNot) => notop.f_expr.to_rewriting
    case binop @ BinOp =>
        rewriting.RelationOp(
            f_left = binop.f_left.to_rewriting,
            f_right = binop.f_right.to_rewriting,
            f_op = match binop.f_op {
                case OpEq  => rewriting.OpNeq()
                case OpNeq => rewriting.OpEq()
                case OpLt  => rewriting.OpGte()
                case OpLte => rewriting.OpGt()
                case OpGt  => rewriting.OpLte()
                case OpGte => rewriting.OpLt()
            }
        )
}


|" Return the full view of the root type of ``t``, traversing subtypes,
|" derivations and privacy.
fun full_root_type(t : BaseTypeDecl) : BaseTypeDecl = {
    val res = t.p_root_type();
    if res.p_is_private() then {
        val full_view = res.p_full_view();
        if full_view == res then res else full_root_type(full_view)
    } else res
}

|" Return true if ``n`` is the name of a type declared in a predefined
|" package spec.
fun is_predefined_type(n : Name) : Bool = {
    # Retrieve the root enclosing package
    val packages = (
        from full_root_type(n.p_name_designated_type()).parents(include_self=false)
        match p@BasePackageDecl
        select p
    ).to_list;

    packages.length > 0 and packages?[packages.length - 1] is
        BasePackageDecl(f_package_name:
                        DefiningName(p_canonical_part(): name @ DefiningName)) when name.p_name_is("Standard")
          or name.p_name_is("System")
          or name.p_name_is("Ada")
          or name.p_name_is("Interfaces")
}

|" Return all parent basic decl nodes starting from a given node, using
|" semantic parent.
|" When on a subprogram or package body, go to the declaration
|" This allows us to, if in a generic template, always find back the
|" generic formal.
fun parent_decl_chain(this : AdaNode, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Stream[AdaNode] =
    unfold(parent_decl_chain_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun parent_decl_chain_body(this : AdaNode) : Rec[AdaNode, AdaNode] = match this {
    case null => Rec[AdaNode, AdaNode]([], [])
    case decl@(BaseSubpBody | PackageBody) => Rec(non_null({
        val prev_part = decl.p_decl_part();

        # Some subprogram bodies don't have a previous part because they're
        # also the decl. In that case, return the semantic parent.
        if prev_part != null then prev_part else this.p_semantic_parent()
    }), non_null({
        val prev_part = decl.p_decl_part();

        # Some subprogram bodies don't have a previous part because they're
        # also the decl. In that case, return the semantic parent.
        if prev_part != null then prev_part else this.p_semantic_parent()
    }))
    case _ => Rec(
        non_null(this.p_semantic_parent()),
        non_null(this.p_semantic_parent())
    )
}


|" If ``n`` is part of a generic package or subprogram, whether it is
|" instantiated or not, then return it.
fun closest_enclosing_generic(n : AdaNode) : GenericDecl = {
    val g = (
        from parent_decl_chain(n)
        match g@GenericDecl
        select g
    ).head_or(null);
    if g != null then g.p_get_uninstantiated_node().as[GenericDecl] else null
}

# TODO: move to LAL
|" Return true if ``n`` is part of a generic instantiation.
fun in_generic_instance(n : AdaNode) : Bool =
    n.p_generic_instantiations().length != 0

|" Return true if ``n`` is declared as part of a generic template (spec
|" or body). Return false otherwise, including inside a generic
|" instantiation.
fun in_generic_template(n : AdaNode) : Bool =
    n != null and {
        val closest_gen = closest_enclosing_generic(n);
        val insts = n.p_generic_instantiations();
        val last_inst =
            if insts.length > 0
            then insts?[insts.length - 1]
            else null;

        # Check that the node is in a generic and that either
        # 1. It's part of no instantiations
        (closest_gen != null and last_inst == null)

        # 2. The last instantiation on the instantiation stack does not
        # correspond to the innermost generic that we found.
        or (last_inst != null
            and last_inst.p_designated_generic_decl().p_get_uninstantiated_node()
           != closest_gen)
    }

|" Return the first ``DeclBlock`` enclosing ``n`` if any, ``null``
|" otherwise.
fun enclosing_block(n : AdaNode) : DeclBlock = (
    from n.parents(include_self=false)
    match db@DeclBlock
    select db
).head_or(null)

|" Return the first BodyNode enclosing n if any, null otherwise
@memoized
fun enclosing_body(n : AdaNode) : BodyNode = (
    from n.parents(include_self=false)
    match bn@BodyNode
    select bn
).head_or(null)

|" Return the first BasePackageDecl or PackageBody enclosing n if any,
|" null otherwise
@memoized
fun enclosing_package(n : AdaNode) : BasicDecl = (
    from n.parents(include_self=false)
    match pkg@(BasePackageDecl | PackageBody)
    select pkg
).head_or(null)

|" Given a node representing an instantiation of a generic subprogram,
|" return that non-instantiated subprogram after resolving all renamings.
fun ultimate_designated_generic_subp(subp_inst : GenericSubpInstantiation) : GenericSubpDecl = {
    val inst = subp_inst.p_designated_generic_decl();
    val aliased = ultimate_subprogram_alias(inst);
    aliased.p_get_uninstantiated_node().as[GenericSubpDecl]
}

# TODO: move to LAL
|" Return true if t is a classwide TypeDecl.
fun is_classwide_type(t : BaseTypeDecl) : Bool =
    t is (ClasswideTypeDecl |
         BaseSubtypeDecl(p_base_subtype(): ClasswideTypeDecl))

# TODO: move to LAL
|" Return true if `t` is a TypeExpr corresponding to a controlling
|" parameter of the subprogram spec `spec`.
fun is_controlling_param_type(t : TypeExpr, spec : BaseSubpSpec) : Bool =
    t is TypeExpr(p_designated_type_decl(): d @ BaseTypeDecl)
    when ((d.p_is_tagged_type() and not is_classwide_type(d)) or
          (d is AnonymousTypeDecl and
           d.p_accessed_type()?.p_is_tagged_type() and
           not is_classwide_type(d.p_accessed_type())))
     # Check that t is in the same package decl as spec
     and (enclosing_package(t) == enclosing_package(spec))

# TODO: move to LAL?
|" Return true if spec is a subprogram spec of a constructor, that is, has
|" a controlling result and no controlling parameter.
fun is_constructor(spec : BaseSubpSpec) : Bool =
    is_controlling_param_type(spec.p_returns(), spec)
    and not spec.p_params().any(
        (p) => is_controlling_param_type(p.f_type_expr, spec)
    )

|" Return true is node represents a constant object, false otherwise
fun is_constant_object(node : BasicDecl) : Bool =
    node is (ObjectDecl | ParamSpec) and node.p_is_constant_object()

|" Return true if node represents an instantiation of the
|" `Ada.Unchecked_Conversion` subprogram
fun is_unchecked_conversion(node : AdaNode) : Bool =
    node is gi@GenericSubpInstantiation when {
        val subp = ultimate_designated_generic_subp(gi);
        val fqn = subp.p_fully_qualified_name();
        fqn == "Ada.Unchecked_Conversion" or fqn == "Unchecked_Conversion"
    }

|" Return true if node represents an instantiation of the
|" `Ada.Unchecked_Deallocation` subprogram
fun is_unchecked_deallocation(node : AdaNode) : Bool =
    node is gi@GenericSubpInstantiation when {
        val subp = ultimate_designated_generic_subp(gi);
        val fqn = subp.p_fully_qualified_name();
        fqn == "Ada.Unchecked_Deallocation" or fqn == "Unchecked_Deallocation"
    }

|" Given a BaseTypeDecl, returns whether the declared type is a composite
|" Ada type (record, array, task or protected).
fun is_composite_type(decl : BaseTypeDecl) : Bool = {
    val v = decl.p_full_view();
    v.p_is_array_type() or
    v.p_is_record_type() or
    v.p_is_interface_type() or
    v.p_root_type() is (TaskTypeDecl | ProtectedTypeDecl)
}

|" Return the SubpBody, TaskBody or ExprFunction corresponding to node,
|" if any, null otherwise.
@memoized
fun get_subp_body(node : AdaNode) : BasicDecl = match node {
    case r@SubpRenamingDecl =>
        get_subp_body(r.f_renames.f_renamed_object.p_referenced_decl())
    case body@BaseSubpBody => body
    case EnumLiteralDecl  => null
    case decl@ClassicSubpDecl  => decl.p_body_part()
    case gi@GenericSubpInstantiation =>
        match gi.p_designated_generic_decl() {
            case d@GenericPackageDecl => d.p_body_part()
            case d@GenericSubpDecl => d.p_body_part()
        }
    case stub@SubpBodyStub     => stub.p_body_part_for_decl()
    case e@EntryDecl        =>
        # For a task entry decl, return the task body as an over approximation
        # TODO: replace p_next_part_for_decl once U920-016 if fixed.
        match node.p_semantic_parent() {
             case d @ SingleTaskTypeDecl =>
                d.parent.as[SingleTaskDecl].p_next_part_for_decl()
             case d @ TaskTypeDecl => d.p_next_part_for_decl()
             case _ => e.p_body_part()
        }
    case td@TaskTypeDecl => td.p_next_part_for_decl()
    case bd@BasicDecl when bd.p_is_subprogram() =>
        bd.p_body_part_for_decl()
    case _                => null
}


|" Return `true` if type is a limited type. This function expects `type` to
|" be a BaseTypeDecl.
|"
|" .. WARNING::
|"   This function is deprecated. Call `type.p_is_limited_type()` instead.
fun is_limited_type(type : BaseTypeDecl) : Bool = type.p_is_limited_type()

|" Return a (cached) list of all known units
@memoized
fun list_of_units() : List[AnalysisUnit] = units().to_list

|" Return a string with basename:line corresponding to node's sloc
fun sloc_image(node : AdaNode) : String = {
    val tok = node.token_start();
    base_name(tok.unit.name) & ":" & img(tok.start_line)
}

|" Return true if a comment token immediately following the previous
|" "begin" keyword is found and contains only the provided name.
fun find_comment(token : Token, name : String) : Bool =
    if token.kind == "comment" and
       token.previous().previous().kind == "begin"
    then
        token.text.ends_with(name) and
        match token.text.substring(1, token.text.length - name.length) {
            case "^-- *$" => true
            case _        => false
        }
    else
        token.kind != "begin" and find_comment(token.previous(), name)

|" Return the index of the first non blank character of s, starting at ind
fun first_non_blank(s : String, ind : Int=1) : Int =
    match s.substring(ind, ind) {
        case "[ \t]" => first_non_blank(s, ind + 1)
        case _       => ind
    }


|" Return the start line of the next non blank token, or the next line for
|" a comment, or 0 if none.
fun next_non_blank_token_line(token : Token) : Int = {
    val n = token.next();
    match n.kind {
        case "whitespace"  => next_non_blank_token_line(n)
        case "comment"     => n.start_line + 1
        case "termination" => 0
        case "no_token"    => 0
        case _             => n.start_line
    }
}

|" Return the end line of the previous non blank token, or the previous
|" line for a comment, or 0 if none.
fun previous_non_blank_token_line(token : Token) : Int = {
    val p = token.previous();
    match p.kind {
        case "whitespace"  => previous_non_blank_token_line(p)
        case "comment"     => p.start_line - 1
        case "termination" => 0
        case "no_token"    => 0
        case _             => p.end_line
    }
}

|" Return the max value between x and y
fun max(x : BigInt, y : BigInt) : BigInt =
    if x > y then x else y

|" Return the number of values covered between left and right expressions,
|" -1 if it cannot be determined.
fun range_values(left : Expr, right : Expr) : BigInt =
    if right.p_is_static_expr() and left.p_is_static_expr()
    then max(right.p_eval_as_int() - left.p_eval_as_int() + 1b, 0b)
    else -1b

|" Return the number of values covered by a given BaseTypeDecl, -1 if
|" this value cannot be determined.
fun number_of_values(type : BaseTypeDecl) : BigInt = match type {
    case SubtypeDecl(f_subtype: SubtypeIndication(f_constraint: RangeConstraint(f_range: RangeSpec(f_range: op @ BinOp)))) => range_values(op.f_left, op.f_right)
    case st@SubtypeDecl => number_of_values(st.p_get_type())
    case _ when type == type.p_universal_int_type() => -1b
    case td@TypeDecl(f_type_def: type_def) => match type_def {
        case EnumTypeDef(f_enum_literals: e) =>
            match td.f_name?.p_canonical_fully_qualified_name() {
                case "standard.character"           => 256b
                case "standard.wide_character"      => 65536b
                case "standard.wide_wide_character" => 2147483648b
                case _ => e.children.reduce[BigInt]((c: BigInt, n: Node) => c + 1b, 0b)
            }
        case m @ ModIntTypeDef when m.f_expr.p_is_static_expr() => m.f_expr.p_eval_as_int()
        case s @ SignedIntTypeDef when s.f_range.f_range is BinOp(f_op: OpDoubleDot) => {
            val op = s.f_range.f_range.as[BinOp];
            range_values(op.f_left, op.f_right)
        }
        case DerivedTypeDef(f_subtype_indication: SubtypeIndication(f_constraint: RangeConstraint(f_range: RangeSpec(f_range: op @ BinOp)))) =>
            range_values(op.f_left, op.f_right)
        case DerivedTypeDef(f_subtype_indication: s@SubtypeIndication) =>
            number_of_values(s.p_designated_type_decl())
        case _ => -1b
    }
}


|" Return true if ``n`` is an interface or implements some interfaces
fun has_interfaces(n : BaseTypeDecl) : Bool =
    n.p_is_interface_type() or
    n is node @ TypeDecl when super_types(node).any(
        (n) => n is TypeDecl(p_is_interface_type(): true)
    )

|" Return true if the given HandledStmts node may propagate an exception,
|" namely if:
|"
|" - it has no exception handler with a ``when others`` choice;
|" - or it has an exception handler containing a raise statement, or a call
|"   to ``Ada.Exception.Raise_Exception`` or
|"   ``Ada.Exception.Reraise_Occurrence``.
@memoized
fun propagate_exceptions(stmts : HandledStmts) : Bool = not (
    # Look for a when others handler
    (
         from stmts.f_exceptions.children
         match e@ExceptionHandler
         select e if (
             (from subtree(e.f_handled_exceptions) match OthersDesignator).head_or(null)) != null
    ).head_or(null) != null
    and
    # and no (re)raise statement
    ((from (stmts.f_exceptions.children).flat_map(subtree) match (RaiseStmt |
           CallStmt(f_call: c @ CallExpr) when {
               val name = c.f_name.p_referenced_decl()
                           ?.p_fully_qualified_name();
               name == "Ada.Exceptions.Raise_Exception" or
               name == "Ada.Exceptions.Reraise_Occurrence" })).head_or(null)) == null)

|" Return true if ``param`` (a ``ParamActual``) has a non aliased by-copy
|" type
fun is_by_copy(param : ParamActual) : Bool =
    not (param.param.parent.parent is ParamSpec(f_has_aliased: AliasedPresent))
    and param.actual.p_expression_type() is expr @ BaseTypeDecl
    when expr.p_root_type().p_full_view().p_root_type() is t @ BaseTypeDecl
    when t.p_is_discrete_type() or t.p_is_access_type() or
         t.p_is_fixed_point() or t.p_is_float_type()

|" Get whether the provided parameter (a ``ParamActual``) type is a
|" by-reference" type as defined in the reference manual at 6.2(4-9).
fun is_by_ref(param : ParamActual) : Bool = {
    fun is_type_by_ref(type_decl : BaseTypeDecl) : Bool =
        type_decl is (
            BaseTypeDecl(p_is_tagged_type(): true)
            | TaskTypeDecl
            | ProtectedTypeDecl
            | TypeDecl(f_type_def: RecordTypeDef(f_has_limited: LimitedPresent))
            | BaseTypeDecl(p_is_private(): true) when is_type_by_ref(type_decl.p_full_view())
            | BaseTypeDecl when is_composite_type(type_decl)
                and any((from component_types(type_decl)
                         match t@BaseTypeDecl
                         select is_type_by_ref(t)))
            | SubtypeDecl when is_type_by_ref(type_decl.p_base_subtype())
        );
    val param_spec = (from parent(param.param)
                      match p@ParamSpec
                      select p).head_or(null);
    is_type_by_ref(param_spec.f_type_expr.p_designated_type_decl())
}

|" Given a ``List[ParamActual]``, return the parameter corresponding to
|" actual, null if actual is not found.
fun get_parameter(params : List[ParamActual], actual : Expr) : DefiningName = {
    fun find(params : List[ParamActual], actual : Expr, n : Int) : DefiningName =
        if n == 0 then null
        else if params?[(n)-1].actual == actual then params?[n-1].param
        else find(params, actual, n - 1);
    find(params, actual, params.length)
}

|" Given a ``List[ParamActual]``, return the parameter actual value
|" corresponding to the provided ``name``, null if not found.
fun get_parameter_with_name(params : List[ParamActual], name : String) : Expr =
    (from params match p select p.actual if p.param.p_name_is(name)).head_or(null)

struct FormalParam {
    name: DefiningName
    param_spec: ParamSpec
}

|" Given a SubpSpec node, return a list of all its formal parameter
|" defining names, each one associated to its ParamSpec node.
fun get_formals(subp_spec : BaseSubpSpec) : List[FormalParam] = concat((
    from subp_spec.p_params()
    match param_spec@ParamSpec
    select (
        from (
            from subtree(param_spec)
            match dn@DefiningName
            select dn
        )
        match name
        select FormalParam(name, param_spec)
    ).to_list
).to_list)

|" Strip ``ParenExpr`` from the provided node.
fun strip_parenthesis(node : Expr) : Expr = match node {
    case pe@ParenExpr => strip_parenthesis(pe.f_expr)
    case _ => node
}


|" Strip ``ParenExpr``, ``QualExpr`` and type conversions
@memoized
fun strip_conversions(node : Expr) : Expr = match node {
    # Strip parenthesis
    case pe@ParenExpr => strip_conversions(pe.f_expr)
    # Strip type qualifications
    case qe@QualExpr  => strip_conversions(qe.f_suffix)
    # Strip type conversions
    case CallExpr(p_kind(): "type_conversion", f_suffix: args@AssocList) =>
        strip_conversions(args.children[0].as[ParamAssoc].f_r_expr)
    case _ => node
}


|" Return ``n.f_prefix`` as long as ``n`` is a ``DottedName`` and
|" designates a ``ComponentDecl``, ``n`` otherwise.
fun ultimate_prefix(n : Name) : Name = match n {
    case dn@DottedName when dn.p_referenced_decl() is ComponentDecl =>
        ultimate_prefix(dn.f_prefix)
    case _ => n
}

|" Return the value of ``System.Default_Bit_Order``.
@memoized
fun default_bit_order() : Expr = {
    val system = get_unit("system", "unit_specification");
    (
        (
            from subtree(system.root)
            match decl @ ObjectDecl(f_has_constant: ConstantPresent, f_default_expr: not null)
            when decl.p_canonical_fully_qualified_name() == "system.default_bit_order"
            select decl
        ).head_or(null)
    ).f_default_expr
}

|" Return the value of ``System.Storage_Unit``, 8 if not found.
@memoized
fun storage_unit() : BigInt = {
    val system = get_unit("system", "unit_specification");
    val decl = (
        if system == null
        then null
        else (
            from subtree(system.root)
            match n@NumberDecl
            when n.p_canonical_fully_qualified_name() == "system.storage_unit"
            select n
        ).head_or(null)
    );
    if decl == null then 8b else decl.f_expr.p_eval_as_int()
}

|" Return true if ``decl`` has a ``Scalar_Storage_Order`` aspect whose
|" value cannot be determined to be equal to
|" ``System.Default_Storage_Order``.
fun has_non_default_sso(decl : BasicDecl) : Bool = {
    val aspect = decl.p_get_aspect("Scalar_Storage_Order");

    aspect.exists and {
        val aspect_fqn = ultimate_alias(aspect.value.as[Name])
                         .as[BasicDecl].p_canonical_fully_qualified_name();
        aspect_fqn != "system.default_bit_order"
        and match default_bit_order() {
            case null   => true
            case expr => match expr.text {
                case "High_Order_First" =>
                    aspect_fqn != "system.bit_order.high_order_first"
                case "Low_Order_First" =>
                    aspect_fqn != "system.bit_order.low_order_first"
                case _ => true
            }
        }
    }
}

|" Given a `ComponentDecl`, return whether it depends on a mutable
|" discriminant value coming from its parent record declaration.
|" The component depends on a discriminant if it uses it in its subtype
|" constraint or if it is a variant.
fun depends_on_mutable_discriminant(component_decl : ComponentDecl) : Bool = any(
    from
        (
            from subtree(component_decl.p_type_expression().p_subtype_constraint())
            match id@Identifier
            select id
        ) ::: (
            from parent(component_decl)
            match vp@VariantPart
            select vp.f_discr_name
        )
    match id
    select id.p_referenced_decl() is DiscriminantSpec(f_default_expr: not null)
)

|" Returns whether the given node is a construct related to Ada tasking,
|" in other words: All constructs described in the section 9 of Ada RM.
fun is_tasking_construct(node : AdaNode) : Bool =
    node is (
        TaskTypeDecl
        | TaskBody
        | SingleTaskDecl
        | SingleTaskTypeDecl
        | ProtectedTypeDecl
        | ProtectedBody
        | SingleProtectedDecl
        | AcceptStmt
        | AcceptStmtBody
        | RequeueStmt
        | SelectStmt
        | DelayStmt
        | AbortStmt
        | ObjectDecl(p_type_expression: TypeExpr(p_designated_type_decl(): (ProtectedTypeDecl | TaskTypeDecl)))
        | Name(p_is_call: true, p_referenced_decl: d @ BasicDecl when ultimate_subprogram_alias(d) is (
                EntryDecl
                | node @ BasicSubpDecl when parent(node).any((n) => n is ProtectedTypeDecl | ProtectedBody | SingleProtectedDecl)
            ))
    )

|" Return whether the provided declaration is subject to a dynamic or
|" static predicate.
fun is_subject_to_predicate(decl : BasicDecl) : Bool =
    decl.p_has_aspect("predicate")
    or decl.p_has_aspect("static_predicate")
    or decl.p_has_aspect("dynamic_predicate")

|" Return whether the provided subtype indication declare
|" constraints.
fun is_subtype_indication_constrained(subtype_indication : SubtypeIndication) : Bool =
    subtype_indication.f_constraint is not null
    or is_constrained_subtype(subtype_indication.p_designated_type_decl())

|" Return whether the provided base type declaration declare a constrained
|" type. This function also looks for constrains in parents of the type.
fun is_constrained_subtype(type_decl : BaseTypeDecl) : Bool =
    (
        type_decl.p_has_aspect("Predicate")
        and not type_decl.p_is_statically_predicated()
    )
    or type_decl.p_has_aspect("Dynamic_Predicate")
    or type_decl.p_full_view() is BaseTypeDecl when match type_decl {
        case td@TypeDecl =>
            match td.f_type_def {
                case ArrayTypeDef(f_indices: ConstrainedArrayIndices) => true
                case d @ DerivedTypeDef => is_subtype_indication_constrained(d.f_subtype_indication)
                case _ => false
            }
        case sd @ SubtypeDecl => is_subtype_indication_constrained(sd.f_subtype)
    }


|" Return all the ``BaseTypeDecl`` corresponding to all fields of a given
|" type, including their full views, base types and subtypes.
fun component_types(this : BasicDecl, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Stream[BaseTypeDecl] =
    unfold(component_types_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun component_types_body(this : BasicDecl) : Rec[BasicDecl, BaseTypeDecl] = match this {
    case TypeDecl(f_type_def: d @ RecordTypeDef) =>
        Rec[BasicDecl, BaseTypeDecl](
            [],
            (from subtree(d) match cd@ComponentDecl select cd).to_list
        )
    case td@TypeDecl(f_type_def: DerivedTypeDef(f_record_extension:
                                            def @ BaseRecordDef)) =>
        Rec[BasicDecl, BaseTypeDecl](
            [],
            [td.p_base_type().as[BasicDecl]]
            & (from subtree(def) match cd@ComponentDecl select cd).to_list
        )
    case td@TypeDecl(f_type_def: DerivedTypeDef) =>
        Rec[BasicDecl, BaseTypeDecl](
            non_null(td.p_base_type()),
            non_null(td.p_base_type())
        )
    case td@TypeDecl(f_type_def: ArrayTypeDef) =>
        Rec[BasicDecl, BaseTypeDecl](
            non_null(td.p_comp_type()),
            non_null(td.p_comp_type())
        )
    case td@TypeDecl(f_type_def: PrivateTypeDef) =>
        Rec[BasicDecl, BaseTypeDecl](
            non_null(td.p_full_view()),
            non_null(td.p_full_view())
        )
    case sd@SubtypeDecl =>
        Rec[BasicDecl, BaseTypeDecl](
            non_null(sd.p_base_subtype()),
            non_null(sd.p_base_subtype())
        )
    case ComponentDecl(f_component_def: ComponentDef(f_type_expr:
                       ind @ SubtypeIndication))  =>
        Rec[BasicDecl, BaseTypeDecl](
            non_null(ind.p_designated_type_decl()),
            non_null(ind.f_name.p_referenced_decl())
        )
    case _ =>
        Rec[BasicDecl, BaseTypeDecl]([], [])
}


|" Return all base (sub)types full views
fun full_parent_types(this : BaseTypeDecl, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Stream[BaseTypeDecl] =
    unfold(full_parent_types_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun full_parent_types_body(this : BaseTypeDecl) : Rec[BaseTypeDecl, BaseTypeDecl] = match this {
    case SubtypeDecl => Rec(
        non_null(this.p_base_subtype().p_full_view()),
        non_null(this.p_base_subtype().p_full_view())
    )
    case ClasswideTypeDecl => Rec(
        non_null(this.f_name.p_basic_decl().as[BaseTypeDecl].p_full_view()),
        non_null(this.f_name.p_basic_decl().as[BaseTypeDecl].p_full_view())
    )
    case BaseTypeDecl => Rec(
        this.p_full_view().p_base_types(),
        this.p_full_view().p_base_types()
    )
    case _ => Rec[BaseTypeDecl, BaseTypeDecl]([], [])
}

fun follow_generics(this: Node): Stream[AdaNode] = match this {
    case gi@GenericInstantiation => {
        val gen_decl = gi.p_designated_generic_decl();
        val gen_body = gen_decl.p_body_part_for_decl(false);
        gi :: (this.children
            & [gen_decl]
            & if gen_body is not null then [gen_body] else []
        ).flat_map(follow_generics)
    }
    case stub@BodyStub when stub.p_generic_instantiations().length > 0 =>
        stub :: (
            this.children
            & [stub.p_next_part_for_decl(false)]
        ).flat_map(follow_generics)
    case n@AdaNode =>
        n :: this.children.flat_map(follow_generics)
    case _ => nil[AdaNode]()
}
