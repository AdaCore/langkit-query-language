# ----- Misc -----

# generic[A, B]
struct Pair {
    fst: A
    snd: B
}

|" Yields all the descendants of the given node (including itself)
fun subtree(this: AdaNode): Stream[AdaNode] =
    match this {
        case AdaNode => this :: this.children.flat_map(subtree)
        case _ => nil()
    }

fun follow_generics(this : AdaNode) : Stream[AdaNode] =
    match this {
        case GenericInstantiation => {
            val gen_decl = this.p_designated_generic_decl();
            val gen_body = gen_decl.p_body_part_for_decl(false);
            this :: (this.children
                & [gen_decl]
                & if gen_body is not null then [gen_body] else []
            ).flat_map(follow_generics)
        }
        case BodyStub when this.p_generic_instantiations().length > 0 =>
            this :: (this.children & [this.p_next_part_for_decl(false)]).flat_map(follow_generics)
        case AdaNode => this :: this.children.flat_map(follow_generics)
        case _ => nil()
    }

val all_nodes = units().flat_map((unit: AnalysisUnit) => subtree(unit.root))

# ----- Support for selectors -----

fun make_depth_predicate(depth: Int, min_depth: Int, max_depth: Int): (Int) -> Bool =
    (current_depth: Int): Bool =>
        if depth >= 0 then
            current_depth == depth
         else
            (max_depth < 0 or current_depth <= max_depth)
            and (min_depth < 0 or current_depth >= min_depth)

# generic[In, Out]
struct Rec {
    ret: List[Out]
    nxt: List[In]
}

|" Helper to simulate the builtin Java behavior of `rec`.
|" This is for refactored selectors only, do not use this function.
|" It will probably be removed at a later stage.
fun non_null(value : Any) : Any = if value is null then [] else [value]

# generic[In, Out]
fun unfold(fn: (In) -> Rec[In, Out], p: (Int) -> Bool, nxt: List[In], depth: Int): Stream[Out] = match nxt.length {
    case 0 => nil()
    case _ => {
        val rec = nxt.map((n) => fn(n)).reduce((a, b) => Rec(a.ret & b.ret, a.nxt & b.nxt), Rec([], []));
        val prefix = if p(depth) then rec.ret.to_stream else nil();
        prefix ::: unfold(fn, p, rec.nxt, depth+1)
    }
}

# generic[In, Out]
fun unfold_check_cycles(fn: (In) -> Rec[In, Out], p: (Int) -> Bool, nxt: List[In], depth: Int, seen : List[In]): Stream[Out] = match nxt.length {
    case 0 => nil()
    case _ => {
        val rec = nxt.map((n) => fn(n)).reduce((a, b) => Rec(a.ret & b.ret, a.nxt & b.nxt), Rec([], []));
        val prefix = if p(depth) then rec.ret.to_stream else nil();
        val next = (from unique(nxt) match a when seen.all((b) => a != b)).to_list;
        prefix ::: unfold_check_cycles(fn, p, next, depth+1, seen & next)
    }
}

# This is the LKQL prelude. Those definitions are visible at the root of the LKQL context. This
# is where we put all global definitions that must be accessible in every context

|" Yields all the descendants of the given node
fun children(this : Any, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Any =
    unfold(children_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun children_body(this : Any) : Any = match this {
    case AdaNode => Rec(this.children, this.children)
    case _ => Rec([], [])
}


|" Yields all the next siblings of the given node
fun next_siblings(this : Any, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Any =
    unfold(next_siblings_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun next_siblings_body(this : Any) : Any = match this {
    case AdaNode => Rec(non_null(this.next_sibling()), non_null(this.next_sibling()))
    case _ => Rec([], [])
}


|" Yields all the enclosing parents of the given node
fun parent(this : Any, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Any =
    unfold(parent_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun parent_body(this : Any) : Any = match this {
    case AdaNode => Rec(non_null(this.parent), non_null(this.parent))
    case _ => Rec([], [])
}


|" Yields all the previous siblings of the given node
fun prev_siblings(this : Any, depth : Int = -1, min_depth : Int = -1, max_depth : Int = -1) : Any =
    unfold(prev_siblings_body, make_depth_predicate(depth, min_depth, max_depth), [this], 1)

fun prev_siblings_body(this : Any) : Any = match this {
    case AdaNode => Rec(non_null(this.previous_sibling()), non_null(this.previous_sibling()))
    case _ => Rec([], [])
}
