                        "name": "GNATcheck",
                        "properties": {
                            "commandLine": "gnatcheck -P prj.gpr -m0 -q -l -o /home/fumex/gnatsas/prj/obj/gnatsas/prj.gnatcheck/gnatcheck.out --sarif /home/fumex/gnatsas/prj/obj/gnatsas/prj.gnatcheck/gnatcheck.sarif --emit-fixes --subdirs=gnatsas/prj.gnatcheck -files=obj/gnatsas/prj.gnatsas/sources.txt"
                        }
                    }
                ]
            },
            "invocations": [
