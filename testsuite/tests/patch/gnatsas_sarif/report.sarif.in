    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "GNATSAS",
                    "organization": "AdaCore",
                    "product": "GNAT Static Analysis Suite",
                    "version": "24.0w (unknown_date)",
                    "downloadUri": "https://www.adacore.com/static-analysis/codepeer",
                    "informationUri": "https://www.adacore.com/documentation#GNAT-SAS",
                    "rules": [
                        {
                            "id": "positional parameters",
                            "name": "GNATcheck - positional parameters",
                            "shortDescription": {
                                "text": "positional parameter association"
                            }
                        }
                    ],
                    "isComprehensive": false,
                    "properties": {
